<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.74"
        android:scaleY="0.74"
        android:translateX="17"
        android:translateY="17">

        <!-- Background Badge Circle -->
        <path
            android:pathData="M3,50 a47,47 0 1,0 94,0 a47,47 0 1,0 -94,0"
            android:strokeColor="#0EA5E9"
            android:strokeWidth="2.5">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="0"
                    android:startY="0"
                    android:endX="100"
                    android:endY="100"
                    android:type="linear">
                    <item android:color="#1E293B" android:offset="0.0" />
                    <item android:color="#0F172A" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left Eye Outer Ring -->
        <path
            android:pathData="M9,40 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="9"
                    android:startY="22"
                    android:endX="45"
                    android:endY="58"
                    android:type="linear">
                    <item android:color="#38BDF8" android:offset="0.0" />
                    <item android:color="#0284C7" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left Eye Sclera (White) -->
        <path
            android:pathData="M14,40 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
            android:fillColor="#FFFFFF" />

        <!-- Left Eye Pupil -->
        <path
            android:pathData="M20.5,40 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
            android:fillColor="#0F172A" />

        <!-- Left Eye Glint -->
        <path
            android:pathData="M22.3,37.5 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0"
            android:fillColor="#FFFFFF" />

        <!-- Right Eye Outer Ring -->
        <path
            android:pathData="M55,40 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="55"
                    android:startY="22"
                    android:endX="91"
                    android:endY="58"
                    android:type="linear">
                    <item android:color="#38BDF8" android:offset="0.0" />
                    <item android:color="#0284C7" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right Eye Sclera (White) -->
        <path
            android:pathData="M60,40 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
            android:fillColor="#FFFFFF" />

        <!-- Right Eye Pupil -->
        <path
            android:pathData="M66.5,40 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
            android:fillColor="#0F172A" />

        <!-- Right Eye Glint -->
        <path
            android:pathData="M68.3,37.5 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0"
            android:fillColor="#FFFFFF" />

        <!-- Nose Triangle -->
        <path
            android:pathData="M50,45 L35,68 L65,68 Z"
            android:strokeColor="#0284C7"
            android:strokeWidth="2"
            android:strokeLineJoin="round">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="35"
                    android:startY="45"
                    android:endX="65"
                    android:endY="68"
                    android:type="linear">
                    <item android:color="#38BDF8" android:offset="0.0" />
                    <item android:color="#0EA5E9" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

    </group>

</vector>